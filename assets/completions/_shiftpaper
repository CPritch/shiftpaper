    local commands; commands=()
    _describe -t commands 'shiftpaper help transition commands' commands "$@"
}
(( $+functions[_shiftpaper__subcmd__mode_commands] )) ||
_shiftpaper__subcmd__mode_commands() {
    local commands; commands=()
    _describe -t commands 'shiftpaper mode commands' commands "$@"
}
(( $+functions[_shiftpaper__subcmd__set_commands] )) ||
_shiftpaper__subcmd__set_commands() {
    local commands; commands=()
    _describe -t commands 'shiftpaper set commands' commands "$@"
}
(( $+functions[_shiftpaper__subcmd__slideshow_commands] )) ||
_shiftpaper__subcmd__slideshow_commands() {
