(( $+functions[_shiftpaper__subcmd__help__subcmd__set_commands] )) ||
_shiftpaper__subcmd__help__subcmd__set_commands() {
    local commands; commands=()
    _describe -t commands 'shiftpaper help set commands' commands "$@"
}
(( $+functions[_shiftpaper__subcmd__help__subcmd__slideshow_commands] )) ||
