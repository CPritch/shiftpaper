[Unit]
Description=Shiftpaper parallax wallpaper daemon
Documentation=https://github.com/CPritch/shiftpaper
PartOf=graphical-session.target
After=graphical-session.target
# Stop after repeated failures, such as having no config yet, instead of
# restarting every few seconds forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# systemd looks a bare command name up in /usr/local/bin and /usr/bin, not
# $PATH. For a `cargo install` into ~/.cargo/bin, use the full path here.
ExecStart=shiftpaperd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
